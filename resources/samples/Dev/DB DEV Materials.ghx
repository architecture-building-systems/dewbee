                            <item name="Description" type_name="gh_string" type_code="10">A number between 0 and 1 for the porosity.</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">b61a7aba-0165-437f-8dc0-1e1842963b43</item>

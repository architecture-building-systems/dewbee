This list must have the same length as _sorption_w.</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">f2315c82-3a28-42b0-92d4-8446d4b1d35a</item>
                            <item name="Name" type_name="gh_string" type_code="10">_sorption_rh_</item>
